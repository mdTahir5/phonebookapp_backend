# Backend Environment Variables Template
# Copy this file to .env or configure these variables in your deployment dashboard (Render)

# Server Port (Render sets this automatically via $PORT)
PORT=8080

# Active Spring Profile (prod for production, dev for local)
SPRING_PROFILES_ACTIVE=prod

# Aiven.io MySQL Connection Details
# Replace host, port, dbname, username, and password with your Aiven service credentials
# Note: sslMode=REQUIRED is required for Aiven MySQL
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-phonebook-01-imperialtslearn-1cbd.g.aivencloud.com:11173/phonebook_db?sslMode=REQUIRED&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=AVNS_LVyRfkDtTYChsqi7wxB

# Hibernate DDL Auto (Use 'update' for initial setup or 'validate' when schema is migrated via migration script)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# JWT Configuration (generate a 256-bit or 512-bit secure Base64 key)
# e.g., run: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins: your Netlify frontend URL(s), comma-separated
# e.g., https://phonebook-app.netlify.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://phonebookapp01.netlify.app,http://localhost:5173
